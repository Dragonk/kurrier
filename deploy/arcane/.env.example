# Public URL configured in Zoraxy. Do not expose a host port for web.
WEB_URL=https://kurrier.kmms.ovh
# Existing external Docker network used by Zoraxy, not an IP address.
ZORAXY_PROXY_NETWORK=proxy-network

# The compose file defaults to a dedicated testing directory below /mnt/Dane.
KURRIER_DATA_DIR=/mnt/Dane/kurrier
# Change this single value for test-image upgrades or rollbacks.
# Examples: pr-616 or sha-e682fb43b746155e75d4d4ee68756c0c4dec0bf8
KURRIER_IMAGE_TAG=pr-616

NODE_ENV=production
WEB_PORT=3000
DISABLE_DRIVE=false
DISABLE_LOCAL_LOGIN=false

POSTGRES_USER=kurrier
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
POSTGRES_DB=kurrier
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
DATABASE_URL=postgresql://kurrier:REPLACE_WITH_A_RANDOM_PASSWORD@postgres:5432/kurrier
DATABASE_RLS_URL=postgresql://kurrier:REPLACE_WITH_A_SEPARATE_RANDOM_PASSWORD@postgres:5432/kurrier

REDIS_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

TYPESENSE_API_KEY=REPLACE_WITH_A_RANDOM_KEY
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
SEARCH_REBUILD_ON_BOOT=false

JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
APP_SECRET_ENCRYPTION_KEY=REPLACE_WITH_A_32_BYTE_BASE64_KEY

S3_REGION=garage
S3_BUCKET=kurrier
S3_ENDPOINT=http://garage:3900
S3_ACCESS_KEY=REPLACE_WITH_A_RANDOM_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_KEY
S3_FORCE_PATH_STYLE=true
GARAGE_RPC_SECRET=REPLACE_WITH_A_RANDOM_RPC_SECRET

WORKER_URL=http://worker
DAV_URL=http://dav
WEB_DAV_URL=http://dav
DAV_POSTGRES_USER=baikal
DAV_POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
DAV_POSTGRES_DB=baikal
DAV_DATABASE_URL=postgresql://baikal:REPLACE_WITH_A_RANDOM_PASSWORD@baikal-postgres:5432/baikal
DAV_CONFIG_ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_32_HEX_CHARACTER_KEY
# Generated once for the internal Baikal administrator. Store it securely.
DAV_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
DAV_ADMIN_PASSWORD_HASH=REPLACE_WITH_THE_BAIKAL_ADMIN_SHA256_HASH

# Canaille OIDC: create a dedicated test client with this exact callback:
# ${WEB_URL}/api/auth/oidc/generic/callback
OIDC_ISSUER_URL=https://auth.kmms.ovh
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Canaille
OIDC_SCOPES=openid email profile
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_REQUIRE_VERIFIED_EMAIL=true

# Optional. Keep empty unless test automation needs management API access.
API_ADMIN_KEY=
CUSTOM_EMAIL_PROVIDERS=[]
